# Copy this file to .env and fill in real values.
#   cp .env.example .env
# Never commit .env. It is gitignored.

# --- Required for OCR (Mathpix Convert API) ---
# Create keys at https://console.mathpix.com/
MATHPIX_APP_ID=your_mathpix_app_id
MATHPIX_APP_KEY=your_mathpix_app_key
MATHPIX_URL=https://api.mathpix.com

# --- Optional: documented AI classification (USAGE_GUIDE) ---
# Only needed if you run the OpenRouter classification path.
# OPENROUTER_API_KEY=your_openrouter_api_key

# --- Optional pipeline settings (defaults match config.py) ---
LOG_LEVEL=INFO
ENABLE_API_CACHING=true
ENABLE_CHECKPOINTS=true
MAX_CONCURRENT_REQUESTS=3
TIMEOUT_SECONDS=600
RETRY_ATTEMPTS=5
RETRY_DELAY_SECONDS=10

INPUT_DIR=input
OUTPUT_DIR=output
CACHE_DIR=output/cache
LOGS_DIR=output/logs
CHECKPOINTS_DIR=output/checkpoints

# false = do not send data to Mathpix for product improvement
IMPROVE_MATHPIX=false
SIMPLE_MODE=false
MATHPIX_EXTRACT_ALL_FORMATS=true
CONFIDENCE_THRESHOLD=0.85
