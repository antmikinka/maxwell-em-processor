# Maxwell EM Processor - .gitignore
# Generated 2026-04-26

# ========================
# Python
# ========================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# ========================
# Environment & Secrets
# ========================
.env
.env.*
!.env.example

# ========================
# Logs
# ========================
*.log
logs/

# ========================
# Data & Output
# ========================
# ChromaDB vector store data
chroma_data/
chroma/

# Local processing (not the published edition)
output/
Enhanced_Maxwell_TOC/
Maxwell_TOC/
Maxwell_TOC_Fixed/

# Master-output dumps that are not the readable edition
MAXWELL_VOLUME_1_MASTER_OUTPUT/RAW_OUTPUTS/
MAXWELL_VOLUME_1_MASTER_OUTPUT/PROCESSING_LOGS/
MAXWELL_VOLUME_1_MASTER_OUTPUT/volume_1_direct_result.json
MAXWELL_VOLUME_1_MASTER_OUTPUT/VOLUME_1_ALL_PAGES_ PRELIMINARY.TO CHAPTER XII. JSON
MAXWELL_VOLUME_2_MASTER_OUTPUT/RAW_OUTPUTS/
MAXWELL_VOLUME_2_MASTER_OUTPUT/PROCESSING_LOGS/
MAXWELL_VOLUME_2_MASTER_OUTPUT/volume_2_direct_result.json

# Input binaries: publish Maxwell 1873 scans only
input/*.pdf
input/*.png
input/*.jpg
input/*.jpeg
input/*.tiff
!input/15773-A Treatise On Electricity And Magnetism Vol-i.pdf
!input/15774-A Treatise On Electricity And Magnetism Vol-ii.pdf

# Root-level generated dumps (do not hide published edition JSON)
/*_output.json

# ========================
# IDE & Editors
# ========================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ========================
# Claude / AI assistant artifacts
# ========================
.claude/
.ai/

# ========================
# OS
# ========================
ehthumbs.db
Desktop.ini

# ========================
# Temporary files
# ========================
*.tmp
*.temp
temp/
tmp/

# Vendored SDK test fixtures (LFS corrupt, not needed)
mpxpy/tests/files/

# Operational telemetry
config/total-usage-data.csv

# ========================
# Node (if applicable)
# ========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
