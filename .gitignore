# Maxwell EM Processor - .gitignore
# Generated 2026-04-26

# ========================
# Python
# ========================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/

# Virtual environments
venv/
.venv/
env/
.env/
ENV/

# ========================
# Environment & Secrets
# ========================
.env
.env.*
!.env.example

# ========================
# Logs
# ========================
*.log
logs/

# ========================
# Data & Output
# ========================
# ChromaDB vector store data
chroma_data/
chroma/

# Processing outputs (large files)
output/
MAXWELL_VOLUME_1_MASTER_OUTPUT/
MAXWELL_VOLUME_2_MASTER_OUTPUT/
Enhanced_Maxwell_TOC/
Maxwell_TOC/
Maxwell_TOC_Fixed/

# Input source files (typically large PDFs/images)
input/*.pdf
input/*.png
input/*.jpg
input/*.jpeg
input/*.tiff

# Intermediate JSON artifacts (keep schema, exclude data)
maxwell_article_index.json
*_index.json
*_output.json

# ========================
# IDE & Editors
# ========================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ========================
# Claude / AI assistant artifacts
# ========================
.claude/
.ai/

# ========================
# OS
# ========================
ehthumbs.db
Desktop.ini

# ========================
# Temporary files
# ========================
*.tmp
*.temp
temp/
tmp/

# ========================
# Node (if applicable)
# ========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
